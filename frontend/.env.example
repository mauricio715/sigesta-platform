# Rutas que usa el navegador. En desarrollo pasan por el proxy de Vite.
VITE_API_URL=/api/v1
VITE_IA_URL=/ia/api/v1

# Destinos del proxy de desarrollo (vite.config.js)
VITE_PROXY_LARAVEL=http://127.0.0.1:8000
VITE_PROXY_IA=http://127.0.0.1:8001

# En producción (sin proxy) use URLs completas, por ejemplo:
# VITE_API_URL=https://sigesta.midominio.bo/api/v1
# VITE_IA_URL=https://ia.sigesta.midominio.bo/api/v1
