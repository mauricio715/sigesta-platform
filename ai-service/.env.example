# ---- Groq ----
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Verifique en https://console.groq.com/docs/models que el modelo siga disponible
GROQ_MODEL=llama-3.3-70b-versatile

# ---- API de SI-GESTA (Laravel) ----
LARAVEL_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Generar con:  php artisan sigesta:token-ia
IA_SERVICE_TOKEN=

# ---- Microservicio ----
# Orígenes del frontend React separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ITERACIONES_HERRAMIENTAS=5
MAX_CARACTERES_HERRAMIENTA=12000
TIMEOUT_LARAVEL_SEGUNDOS=15
